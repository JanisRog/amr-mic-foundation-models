# Site configuration for the workflow.
#
# Copy to config/paths.env, fill in the values for your system, and source it
# before running install.sh or submitting any job:
#
#     cp config/paths.env.example config/paths.env
#     $EDITOR config/paths.env
#     source config/paths.env
#
# Every script reads these from the environment and stops with
# "set <VAR> in config/paths.env" if one it needs is unset. Slurm jobs inherit
# them because every submission exports ALL. config/paths.env is git-ignored.
#
# Versions in the comments are the ones used for the published results.

# --- Analysis roots -----------------------------------------------------------
# One root per organism. Each holds its data, results and an installed scripts/
# directory (install.sh fills it). PIPE holds the read-processing pipeline.
export MTB=/path/to/analysis/mtb                 # M. tuberculosis root
export PSEAER=/path/to/analysis/pseaer           # P. aeruginosa root
export PIPE=/path/to/analysis/pipeline           # read QC, variant calling, annotation, embedding
export MTB_SCRIPTS="$MTB/scripts"                # shared plotting helpers, imported by the PA analyses
# pipeline/00_submit/pseaer.env otherwise assumes the PA root sits beside PIPE.
export DATASET_ROOT="$PSEAER"

# --- Python -------------------------------------------------------------------
# One environment for everything: the embedding stage needs the GPU stack
# (PyTorch, transformers, Evo 2's vortex and Transformer Engine, flash-attn),
# the rest needs numpy, pandas, scipy, scikit-learn, matplotlib, shap.
export PY=/path/to/conda/envs/amr/bin/python

# --- Containers -----------------------------------------------------------------
# Bind specification passed to apptainer/singularity, e.g. "/data:/data".
# It must cover every path above and the reference databases below.
export BIND_PATHS=/path/to/data:/path/to/data

export SNIPPY_SIF=/path/to/snippy_4.6.0.sif                    # Snippy 4.6.0
export TBPROFILER_SIF=/path/to/tb-profiler_6.3.0.sif           # TB-Profiler 6.3.0 (tbdb 72ef6fa)
export AMRFINDERPLUS_SIF=/path/to/ncbi-amrfinderplus_4.0.23.sif # AMRFinderPlus 4.0.23
export AMRFINDERPLUS_DB=/path/to/AMRfinderplus/2025-06-03.1   # database 2025-06-03.1

# P. aeruginosa read trimming, assembly and polishing
# (workflow/02_read_qc_assembly_annotation/pa/03_assemble_pseaer_reads_unicycler.sh).
# SING_ROOT is the directory holding the tool images, which the script expects as
# trimmomatic-0.39--hdfd78af_2, unicycler_0.5.0, quay.io-biocontainers-bwa-0.7.17--h5bf99c6_8,
# samtools_1.15.1 and quay.io-biocontainers-pilon-1.24--hdfd78af_0 (override the
# *_IMG variables for other names).
export SING_ROOT=/path/to/singularity/images
export ILLUMINACLIP=/path/to/NexteraPE-PE.fa                    # Trimmomatic adapter file

# P. aeruginosa read QC and annotation (read through pipeline/00_submit/pseaer.env)
export FASTQC_IMG=/path/to/fastqc_0.11.9                       # FastQC 0.11.9
export MULTIQC_IMG=/path/to/multiqc_1.33                       # MultiQC 1.33
export QUAST_IMG=/path/to/quast_5.3.0                          # QUAST 5.3.0
export BAKTA_SIF=/path/to/bakta_1.12.0.img                     # Bakta 1.12.0
export BAKTA_DB=/path/to/bakta_6.0/db                          # Bakta database 6.0

# --- Foundation models ------------------------------------------------------------
# Evo 2 7B is loaded through the evo2 package in $PY. Carbon 8B and DNABERT-2 are
# local model directories; DNABERT-2 runs through the same script as Carbon, with
# CARBON_DIR pointed at it at submission (see workflow/07_embeddings/README.md).
export CARBON_MODEL_DIR=/path/to/carbon-8b

# --- ARDaP (P. aeruginosa comparator) ------------------------------------------------
export ARDAP=/path/to/ARDaP
export ARDAP_ENV=/path/to/conda/envs/ardap
export PICARD_ENV=/path/to/conda/envs/ardap_picard
export JAVA_ENV=/path/to/conda/envs/ardap_java
